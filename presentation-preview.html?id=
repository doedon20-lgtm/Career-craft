];


document.addEventListener(
"DOMContentLoaded",
init
);


async function init(){

const {
data:{session}
}=await supabaseClient.auth.getSession();

if(!session){

location.href="login.html";

return;
}

user=session.user;

document.getElementById("email").textContent=
user.email||"";

document.getElementById("avatar").textContent=
(user.email||"C")[0].toUpperCase();

renderTemplates(templates);
}


function renderTemplates(items){

const container=
document.getElementById("templates");

document.getElementById("count").textContent=
`${items.length} template${items.length===1?"":"s"}`;

if(!items.length){

container.innerHTML=`
<div class="empty">
<h3>No templates found</h3>
<p>Try another search.</p>
</div>
`;

return;
}

container.innerHTML=`
<div class="grid">

${items.map(templateCard).join("")}

</div>
`;
}


function templateCard(template){

return`

<article class="card">

<div class="preview">

<div class="preview-inner ${template.background}">

<div class="preview-title">
${esc(template.title)}
</div>

<div class="preview-sub">
${esc(template.subtitle)}
</div>

<div class="preview-lines">
<i></i>
<i></i>
<i style="width:70%"></i>
</div>

</div>

</div>


<div class="card-body">

<h3>${esc(template.name)}</h3>

<p>${esc(template.description)}</p>

<div class="card-footer">

<span class="count">
${template.slides.length} slides
</span>

<button
class="btn primary"
onclick="selectTemplate('${template.id}')"
>
Use Template
</button>

</div>

</div>

</article>

`;
}


function selectTemplate(id){

selectedTemplate=
templates.find(t=>t.id===id);

if(!selectedTemplate)return;

document.getElementById("presentationTitle").value=
selectedTemplate.title;

document.getElementById("modal").classList.add("show");

setTimeout(()=>{

document
.getElementById("presentationTitle")
.focus();

},100);

}


function closeModal(){

document.getElementById("modal")
.classList.remove("show");

selectedTemplate=null;
}


async function createFromTemplate(){

if(!selectedTemplate)return;

const title=
document
.getElementById("presentationTitle")
.value
.trim();

if(!title){

alert("Enter a presentation title.");

return;
}


const {data,error}=
await supabaseClient
.from("presentations")
.insert({

user_id:user.id,

title:title,

description:selectedTemplate.description,

template:selectedTemplate.id,

is_published:false

})
.select()
.single();


if(error){

alert(error.message);

return;
}


const slideRows=
selectedTemplate.slides.map(
(slide,index)=>({

presentation_id:data.id,

slide_order:index,

layout:slide.layout,

title:slide.title,

subtitle:slide.subtitle,

content:slide.content,

image_url:"",

background:slide.background

})
);


const {
error:slideError
}=
await supabaseClient
.from("presentation_slides")
.insert(slideRows);


if(slideError){

await supabaseClient
.from("presentations")
.delete()
.eq("id",data.id);

alert(slideError.message);

return;
}


location.href=
"presentations.html?edit="+
encodeURIComponent(data.id);
}


function filterTemplates(){

const query=
document
.getElementById("search")
.value
.trim()
.toLowerCase();

const filtered=
templates.filter(template=>

template.name
.toLowerCase()
.includes(query)

||

template.description
.toLowerCase()
.includes(query)

);

renderTemplates(filtered);
}


function toggleMenu(){

document
.getElementById("sidebar")
.classList
.toggle("open");

}


function go(page){

location.href=page;

}


function esc(value){

if(value===null||value===undefined)
return"";

return String(value)

.replaceAll("&","&amp;")
.replaceAll("<","&lt;")
.replaceAll(">","&gt;")
.replaceAll('"',"&quot;")
.replaceAll("'","&#039;");
}
</script>

</body>
</html>
