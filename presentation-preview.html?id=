<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Presentation Templates | CareerCraft</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
--primary:#2563eb;
--purple:#7c3aed;
--dark:#0f172a;
--text:#111827;
--muted:#64748b;
--bg:#f5f7fb;
--white:#fff;
--border:#e5e7eb;
}

body{
font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
background:var(--bg);
color:var(--text);
min-height:100vh
}

button,input{font:inherit}
button{cursor:pointer}

.app{min-height:100vh;display:flex}

.sidebar{
width:240px;
position:fixed;
inset:0 auto 0 0;
background:#fff;
border-right:1px solid var(--border);
padding:22px 15px;
z-index:20
}

.logo{
display:flex;
align-items:center;
gap:9px;
font-weight:800;
font-size:21px;
margin-bottom:30px
}

.logo-icon{
width:38px;
height:38px;
display:grid;
place-items:center;
border-radius:11px;
background:linear-gradient(135deg,#2563eb,#7c3aed);
color:#fff
}

.nav{display:grid;gap:5px}

.nav button{
border:0;
background:transparent;
padding:12px;
border-radius:10px;
text-align:left;
font-weight:650;
color:#475569
}

.nav button:hover,
.nav button.active{
background:#eff6ff;
color:#2563eb
}

.main{
margin-left:240px;
width:calc(100% - 240px);
min-height:100vh
}

.topbar{
height:68px;
background:#fff;
border-bottom:1px solid var(--border);
display:flex;
align-items:center;
justify-content:space-between;
padding:0 25px;
position:sticky;
top:0;
z-index:15
}

.top-left{
display:flex;
align-items:center;
gap:12px
}

.menu{
display:none;
border:0;
background:#f1f5f9;
border-radius:9px;
width:38px;
height:38px
}

.user{
display:flex;
align-items:center;
gap:9px;
font-weight:650
}

.avatar{
width:37px;
height:37px;
border-radius:50%;
background:#dbeafe;
color:#1d4ed8;
display:grid;
place-items:center;
font-weight:800
}

.content{
padding:28px
}

.container{
max-width:1250px;
margin:auto
}

.hero{
background:linear-gradient(135deg,#1d4ed8,#7c3aed);
color:#fff;
border-radius:22px;
padding:32px;
margin-bottom:28px
}

.hero h1{
font-size:32px;
margin-bottom:8px
}

.hero p{
color:#e0e7ff;
max-width:700px;
line-height:1.6
}

.search{
margin-top:22px;
max-width:500px;
position:relative
}

.search input{
width:100%;
padding:13px 15px 13px 43px;
border:0;
border-radius:11px;
outline:none
}

.search span{
position:absolute;
left:15px;
top:12px;
font-size:18px
}

.section-head{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:17px
}

.section-head h2{
font-size:22px
}

.count{
font-size:13px;
color:var(--muted)
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fill,minmax(285px,1fr));
gap:20px
}

.card{
background:#fff;
border:1px solid var(--border);
border-radius:17px;
overflow:hidden;
transition:.2s
}

.card:hover{
transform:translateY(-3px);
box-shadow:0 15px 35px rgba(15,23,42,.09)
}

.preview{
height:180px;
padding:20px;
position:relative;
overflow:hidden
}

.preview-inner{
width:100%;
height:100%;
border-radius:8px;
padding:20px;
display:flex;
flex-direction:column;
justify-content:center;
overflow:hidden
}

.preview-title{
font-size:21px;
font-weight:850;
line-height:1.1;
margin-bottom:9px
}

.preview-sub{
font-size:11px;
opacity:.75;
line-height:1.4
}

.preview-lines{
margin-top:13px;
display:grid;
gap:6px
}

.preview-lines i{
height:5px;
border-radius:4px;
background:currentColor;
opacity:.18;
display:block
}

.card-body{
padding:17px
}

.card-body h3{
font-size:17px;
margin-bottom:6px
}

.card-body p{
font-size:13px;
color:var(--muted);
line-height:1.5;
min-height:39px
}

.card-footer{
display:flex;
align-items:center;
justify-content:space-between;
gap:10px;
margin-top:15px
}

.btn{
border:0;
border-radius:9px;
padding:10px 14px;
font-weight:750
}

.primary{
background:var(--primary);
color:#fff
}

.secondary{
background:#f1f5f9;
color:#334155
}

.btn:hover{
filter:brightness(.97)
}

.empty{
background:#fff;
border:1px dashed #cbd5e1;
border-radius:16px;
padding:50px 20px;
text-align:center;
color:var(--muted)
}

.loading{
padding:45px;
text-align:center;
color:var(--muted)
}

.modal{
position:fixed;
inset:0;
background:rgba(15,23,42,.65);
display:none;
align-items:center;
justify-content:center;
padding:20px;
z-index:100
}

.modal.show{
display:flex
}

.modal-box{
background:#fff;
width:min(500px,100%);
border-radius:18px;
padding:24px
}

.modal-head{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:20px
}

.close{
border:0;
background:#f1f5f9;
width:35px;
height:35px;
border-radius:50%;
font-size:18px
}

.field{
margin-bottom:15px
}

.field label{
display:block;
font-size:12px;
font-weight:800;
margin-bottom:6px
}

.field input{
width:100%;
padding:11px;
border:1px solid #d1d5db;
border-radius:9px;
outline:none
}

.field input:focus{
border-color:var(--primary)
}

.modal-actions{
display:flex;
gap:9px;
margin-top:20px
}

.modal-actions button{
flex:1
}

@media(max-width:900px){
.sidebar{
transform:translateX(-100%);
transition:.2s
}

.sidebar.open{
transform:translateX(0)
}

.main{
margin-left:0;
width:100%
}

.menu{
display:block
}
}

@media(max-width:600px){
.content{
padding:15px
}

.hero{
padding:23px
}

.hero h1{
font-size:25px
}

.grid{
grid-template-columns:1fr
}

.topbar{
padding:0 15px
}

.user span{
display:none
}
}
</style>
</head>

<body>

<div class="app">

<aside class="sidebar" id="sidebar">

<div class="logo">
<div class="logo-icon">C</div>
CareerCraft
</div>

<nav class="nav">

<button onclick="go('index.html')">
🏠 Dashboard
</button>

<button onclick="go('cv-builder.html')">
📄 CV Builder
</button>

<button onclick="go('job-finder.html')">
💼 Jobs
</button>

<button onclick="go('portfolio-dashboard.html')">
🖼️ Portfolio
</button>

<button class="active">
📊 Presentations
</button>

<button onclick="go('communities.html')">
👥 Communities
</button>

<button onclick="go('messages.html')">
💬 Messages
</button>

</nav>

</aside>


<main class="main">

<header class="topbar">

<div class="top-left">

<button class="menu" onclick="toggleMenu()">
☰
</button>

<h2>Presentation Templates</h2>

</div>

<div class="user">

<div class="avatar" id="avatar">C</div>

<span id="email"></span>

</div>

</header>


<section class="content">

<div class="container">

<div class="hero">

<h1>Start with a professional template</h1>

<p>
Choose a presentation style and customize every slide
inside the CareerCraft presentation builder.
</p>

<div class="search">

<span>⌕</span>

<input
id="search"
placeholder="Search templates..."
oninput="filterTemplates()"
>

</div>

</div>


<div class="section-head">

<h2>Templates</h2>

<span class="count" id="count"></span>

</div>


<div id="templates"></div>

</div>

</section>

</main>

</div>


<div class="modal" id="modal">

<div class="modal-box">

<div class="modal-head">

<h2>Create Presentation</h2>

<button class="close" onclick="closeModal()">×</button>

</div>

<div class="field">

<label>Presentation title</label>

<input
id="presentationTitle"
placeholder="My Presentation"
>

</div>

<div class="modal-actions">

<button
class="btn secondary"
onclick="closeModal()"
>
Cancel
</button>

<button
class="btn primary"
onclick="createFromTemplate()"
>
Create
</button>

</div>

</div>

</div>


<script>
const SUPABASE_URL="YOUR_SUPABASE_URL";
const SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY";

const supabaseClient=supabase.createClient(
SUPABASE_URL,
SUPABASE_ANON_KEY
);

let user=null;
let selectedTemplate=null;

const templates=[

{
