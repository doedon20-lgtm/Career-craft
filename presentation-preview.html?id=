name:"Interview Presentation",
description:"Create a strong presentation for interviews and career opportunities.",
background:"dark",
title:"Interview Presentation",
subtitle:"My professional journey",
slides:[
{
layout:"title",
title:"Interview Presentation",
subtitle:"My professional journey",
content:"",
